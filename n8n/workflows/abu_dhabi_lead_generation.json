          {
            "node": "Attach Profile",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Company Profile": {
      "main": [
        [
          {
            "node": "Attach Profile",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Attach Profile": {
      "main": [
        [
          {
            "node": "Send One-by-One",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send One-by-One": {
      "main": [
        [
          {
            "node": "Prepare Email Payload",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Summarise Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Email Payload": {
      "main": [
        [
          {
            "node": "Send Company Profile",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Company Profile": {
      "main": [
        [
          {
            "node": "Send One-by-One",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
